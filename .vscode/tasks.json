{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Jekyll Serve",
			"type": "shell",
			"command": "bundle exec jekyll serve --incremental --livereload --force_polling",
			"isBackground": true,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Pull scratch drafts from pCloud",
			"type": "shell",
			"command": "python bin/sync_scratch.py pull",
			"problemMatcher": []
		},
		{
			"label": "Sync scratch drafts with pCloud",
			"type": "shell",
			"command": "python bin/sync_scratch.py sync",
			"problemMatcher": []
		}
	]
}