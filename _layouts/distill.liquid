<!doctype html>
<html>
  <head>
    {% include head.liquid %}

    {% if page.collection == 'previews' and page.preview_redirect == true %}
      {%- assign published_url = page.url | replace_first: '/preview/', '/blog/' -%}
      {%- assign matching_post = site.posts | where: 'slug', page.slug | first -%}
      {% if matching_post %}
        <link rel="canonical" href="{{ published_url | absolute_url }}">
        <meta http-equiv="refresh" content="0; url={{ published_url | relative_url }}">
        <script>
          window.location.replace("{{ published_url | relative_url }}");
        </script>
      {% endif %}
    {% endif %}

    <!-- Distill js -->
    <script src="{{ '/assets/js/distillpub/template.v2.js' | relative_url }}"></script>
    <script src="{{ '/assets/js/distillpub/transforms.v2.js' | relative_url }}"></script>
    {% if page._styles %}
      <!-- Page/Post style -->
      <style type="text/css">
        {{ page._styles }}
      </style>
    {% endif %}
  </head>

  <d-front-matter>
    <script async type="text/json">
      {
            "title": "{{ page.title }}",
            "description": "{{ page.description }}",
            "published": "{{ page.date | date: '%B %d, %Y' }}",
            "authors": [
              {% for author in page.authors %}
              {
                "author": "{{ author.name }}",
                "authorURL": "{{ author.url }}",
                "affiliations": [
                  {
                    "name": "{{ author.affiliations.name }}",
                    "url": "{{ author.affiliations.url }}"
                  }
                ]
              }{% if forloop.last == false %},{% endif %}
              {% endfor %}
            ],
            "katex": {
              "delimiters": [
                {
                  "left": "$",
                  "right": "$",
                  "display": false
                },
                {
                  "left": "$$",
                  "right": "$$",
                  "display": true
                }
              ]
            }
          }
    </script>
  </d-front-matter>

  <body class="{% if site.navbar_fixed %}fixed-top-nav{% endif %} {% unless site.footer_fixed %}sticky-bottom-footer{% endunless %}">
    <!-- Header -->
    {% include header.liquid %}

    <!-- Content -->
    <div class="post distill">
      {% if page.draft_preview %}
        <div class="draft-preview-banner" style="background: #141001; border: 1px solid #fbff07; border-radius: 8px; padding: 12px 20px; margin-bottom: 20px; text-align: center; font-size: 0.95rem; color: #f6bf19;">
          📝 <strong style="color: inherit;">Draft Preview</strong> — This post is not yet published. Please don't share this link widely.
        </div>
      {% endif %}

      {% assign should_log_read_time = false %}
      {% if page.draft_preview %}
        {% assign should_log_read_time = true %}
      {% endif %}
      {% if page.exclude_appendix_from_word_count %}
        {% assign should_log_read_time = true %}
      {% endif %}
      {% if page.exclude_footnotes_from_word_count %}
        {% assign should_log_read_time = true %}
      {% endif %}
      {% unless site.log_read_time_to_console %}
        {% assign should_log_read_time = false %}
      {% endunless %}

      {% if should_log_read_time %}
        {%- assign full_word_count = page.content | number_of_words -%}
        <script>
          const fullMinutes = ({{ full_word_count }} / 180) + 1;
          console.log('Read time (full): ' + fullMinutes.toFixed(2) + ' min read');
        </script>
        {% if page.exclude_appendix_from_word_count %}
          {%- assign no_appendix_word_count = page.content | content_without_appendix | number_of_words -%}
          <script>
            const noAppendixMinutes = ({{ no_appendix_word_count }} / 180) + 1;
            console.log('Read time (without appendix): ' + noAppendixMinutes.toFixed(2) + ' min read');
          </script>
        {% endif %}
        {% if page.exclude_footnotes_from_word_count %}
          {%- assign no_footnotes_word_count = page.content | content_without_footnotes | number_of_words -%}
          <script>
            const noFootnotesMinutes = ({{ no_footnotes_word_count }} / 180) + 1;
            console.log('Read time (without footnotes): ' + noFootnotesMinutes.toFixed(2) + ' min read');
          </script>
        {% endif %}
        {% if page.exclude_appendix_from_word_count and page.exclude_footnotes_from_word_count %}
          {%- assign final_word_count = page.content | content_without_appendix | content_without_footnotes | number_of_words -%}
          <script>
            const finalMinutes = ({{ final_word_count }} / 180) + 1;
            console.log('Read time (final): ' + finalMinutes.toFixed(2) + ' min read');
          </script>
        {% endif %}
      {% endif %}
      <d-title>
        <h1>{{ page.title }}</h1>
        <p>{{ page.description }}</p>
      </d-title>
      {% if page.authors %}
        <d-byline></d-byline>
      {% endif %}

      <d-article>
        {% if page.toc and page.toc.size > 0 %}
          <d-contents>
            <nav class="l-text figcaption">
              <h3>Contents</h3>
              {% for section in page.toc %}
                <div>
                  <a href="#{% if section.slug %}{{ section.slug }}{% else %}{{ section.name | slugify }}{% endif %}">{{ section.name }}</a>
                </div>
                {% if section.subsections %}
                  <ul>
                    {% for subsection in section.subsections %}
                      <li>
                        <a href="#{% if subsection.slug %}{{ subsection.slug }}{% else %}{{ subsection.name | slugify }}{% endif %}">{{ subsection.name }}</a>
                      </li>
                    {% endfor %}
                  </ul>
                {% endif %}
              {% endfor %}
            </nav>
          </d-contents>

        {% elsif page.toc == true %}
          <d-contents>
            <nav class="l-text figcaption">
              <h3>Contents</h3>
              {% toc %}
            </nav>
          </d-contents>
        {% endif %}

        {% if page.collapse_appendix %}
          {{ content | collapse_appendix }}
        {% else %}
          {{ content }}
        {% endif %}
      </d-article>

      <d-appendix>
        <d-footnote-list></d-footnote-list>
        <d-citation-list></d-citation-list>
      </d-appendix>

      <d-bibliography src="{{ page.bibliography | prepend: '/assets/bibliography/' | relative_url }}"></d-bibliography>

      <d-article>
        {% assign show_newsletter = false %}
        {% if site.newsletter and site.newsletter.enabled %}
          {% assign show_newsletter = true %}
        {% endif %}

        {% assign show_related_posts = false %}
        {% if site.related_blog_posts and site.related_blog_posts.enabled %}
          {% if page.related_posts == nil or page.related_posts %}
            {% assign show_related_posts = true %}
          {% endif %}
        {% endif %}

        {% if show_newsletter and show_related_posts %}
          <h2 class="text-3xl font-semibold mb-4 mt-12">enjoy this article?</h2>
          <p class="mb-2" style="margin-top: 1.5rem !important">subscribe to be notified of future articles:</p>
          {% include newsletter.liquid left=true %}
          <p class="mb-2">and here are some related posts you might like to read next:</p>
          {% include related_posts.liquid compact=true %}
        {% else %}
          {% if show_newsletter %}
            <p class="mb-2" style="margin-top: 1.5rem !important">subscribe to be notified of future articles:</p>
            {% include newsletter.liquid left=true %}
          {% endif %}
          {% if show_related_posts %}
            {% include related_posts.liquid %}
          {% endif %}
        {% endif %}
        <br>
        <br>
        {% if site.disqus_shortname and page.disqus_comments %}{% include disqus.liquid %}{% endif %}
        {% if site.giscus.repo and page.giscus_comments %}
          {% al_comments %}
        {% endif %}
      </d-article>
    </div>

    <!-- Footer -->
    {% include footer.liquid %}

    <!-- JavaScripts -->
    {% include distill_scripts.liquid %}
  </body>
</html>
