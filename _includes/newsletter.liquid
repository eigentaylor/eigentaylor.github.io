<div
  class="newsletter-form-container"
  {% if include.center %}
    style="margin: 20px"
  {% endif %}
>
  {% assign newsletter_form_id = include.id | default: page.url | slugify | default: 'newsletter' %}
  <div class="newsletter-card">
    <div class="newsletter-main">
      <p class="newsletter-eyebrow">newsletter</p>
      <h3 class="newsletter-title">join <b>the eigenletter</b></h3>
      <p class="newsletter-subtitle">you'll get an email when i publish something. i won't spam you, i promise.</p>

      <form
        class="newsletter-form"
        action="https://buttondown.com/api/emails/embed-subscribe/{{ site.newsletter.endpoint }}"
        method="POST"
        style="justify-content: {% if include.left %}flex-start{% elsif include.right %}flex-end{% else %}center{% endif %}"
      >
        <label class="newsletter-form-label" for="bd-email-{{ site.newsletter.endpoint }}-{{ newsletter_form_id }}">Email address</label>
        <input
          class="newsletter-form-input"
          name="email"
          id="bd-email-{{ site.newsletter.endpoint }}-{{ newsletter_form_id }}"
          type="email"
          placeholder="you@example.com"
          required=""
        >

        <button
          type="submit"
          class="newsletter-form-button"
          style="justify-content: {% if include.left %}flex-start{% elsif include.right %}flex-end{% else %}center{% endif %}"
        >
          Subscribe
        </button>

        <button
          type="button"
          class="newsletter-loading-button"
          style="justify-content: {% if include.left %}flex-start{% elsif include.right %}flex-end{% else %}center{% endif %}"
        >
          Please wait...
        </button>
      </form>

      <div
        class="newsletter-success"
        style="justify-content: {% if include.left %}flex-start{% elsif include.right %}flex-end{% else %}center{% endif %}"
      >
        <p class="newsletter-success-message">You're subscribed!</p>
      </div>

      <div
        class="newsletter-error"
        style="justify-content: {% if include.left %}flex-start{% elsif include.right %}flex-end{% else %}center{% endif %}"
      >
        <p class="newsletter-error-message">Oops! Something went wrong, please try again</p>
      </div>

      <button
        class="newsletter-back-button"
        type="button"
        onmouseout='this.style.textDecoration="none"'
        onmouseover='this.style.textDecoration="underline"'
      >
        &larr; Back
      </button>

      <p class="newsletter-powered-by">
        <a href="https://buttondown.com/refer/{{ site.newsletter.endpoint }}" target="_blank" rel="noopener noreferrer">
          powered by buttondown.
        </a>
      </p>
    </div>

    {% if include.show_qr %}
      <div class="newsletter-qr">
        <img src="{{ include.qr_path | relative_url }}" alt="{{ include.qr_alt | default: 'QR code for newsletter sign-up' }}" class="newsletter-qr-image">
        <p class="newsletter-qr-caption">Prefer phone signup? Scan this code.</p>
      </div>
    {% endif %}
  </div>
</div>

<noscript>
  <style>
    .newsletter-form-container {
      display: none;
    }
  </style>
</noscript>
